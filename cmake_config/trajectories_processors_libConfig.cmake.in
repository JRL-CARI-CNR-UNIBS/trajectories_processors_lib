@PACKAGE_INIT@

include(CMakeFindDependencyMacro)

find_dependency(Eigen3 REQUIRED COMPONENTS Core Dense Geometry)
find_dependency(graph_core REQUIRED)

include("${CMAKE_CURRENT_LIST_DIR}/trajectories_processors_libTargets.cmake")

set_and_check(@PROJECT_NAME@_INCLUDE_DIRS "@PACKAGE_CMAKE_INSTALL_INCLUDEDIR@" ${Eigen3_INCLUDE_DIRS} ${graph_core_INCLUDE_DIRS})
set(@PROJECT_NAME@_LIBRARIES @PROJECT_NAME@ ${Eigen3_LIBRARIES} ${graph_core_LIBRARIES})

check_required_components(@PROJECT_NAME@)
